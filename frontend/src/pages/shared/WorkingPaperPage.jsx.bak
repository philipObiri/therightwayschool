import React, { useEffect, useState } from 'react';
import api from '../../lib/api';
import { useAuth } from '../../contexts/AuthContext';
import { Card, CardContent, CardHeader, CardTitle } from '../../components/ui/card';
import { Button } from '../../components/ui/button';
import { Input } from '../../components/ui/input';
import { Label } from '../../components/ui/label';
import { Textarea } from '../../components/ui/textarea';
import { Badge } from '../../components/ui/badge';
import { Dialog, DialogContent, DialogHeader, DialogTitle } from '../../components/ui/dialog';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '../../components/ui/select';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '../../components/ui/tabs';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '../../components/ui/table';
import {
  FileText, FolderOpen, Plus, Upload, Clock, Users, Activity,
  Eye, EyeOff, Send, Search, BarChart3, ArrowLeft, Trash2, Share2
} from 'lucide-react';
import { toast } from 'sonner';
import { successToast } from '../../lib/successToast';

const BACKEND = import.meta.env.VITE_API_URL;

export default function WorkingPaperPage() {
  const { user } = useAuth();
  const isAdmin = ['SuperAdmin', 'Admin', 'CEO', 'Principal', 'HeadTeacher'].includes(user?.role);
  const [tab, setTab] = useState(isAdmin ? 'dashboard' : 'my-paper');

  return (
    <div className="space-y-6" data-testid="working-paper-page">
      <div>
        <h1 className="text-2xl font-bold font-[Manrope] text-[#1B2A4A]">Working Paper</h1>
        <p className="text-slate-500 mt-1">Centralised workspace for tracking work, documents and activity</p>
      </div>
      <Tabs value={tab} onValueChange={setTab}>
        <TabsList className="bg-white border">
          {isAdmin && <TabsTrigger value="dashboard" className="text-xs">Management Dashboard</TabsTrigger>}
          {isAdmin && <TabsTrigger value="live" className="text-xs">Live Activity</TabsTrigger>}
          {isAdmin && <TabsTrigger value="staff" className="text-xs">Staff Papers</TabsTrigger>}
          <TabsTrigger value="my-paper" className="text-xs">My Working Paper</TabsTrigger>
        </TabsList>
        {isAdmin && <TabsContent value="dashboard" className="mt-4"><DashboardView /></TabsContent>}
        {isAdmin && <TabsContent value="live" className="mt-4"><LiveActivityView /></TabsContent>}
        {isAdmin && <TabsContent value="staff" className="mt-4"><StaffPapersView /></TabsContent>}
        <TabsContent value="my-paper" className="mt-4"><MyPaperView user={user} /></TabsContent>
      </Tabs>
    </div>
  );
}


function DashboardView() {
  const [stats, setStats] = useState(null);
  useEffect(() => { api.get('/working-paper/dashboard').then(r => setStats(r.data)).catch(() => {}); }, []);
  if (!stats) return <div className="flex justify-center py-8"><div className="w-6 h-6 border-4 border-[#2E6CC4] border-t-transparent rounded-md animate-spin" /></div>;

  return (
    <div className="space-y-4">
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        <Card className="rounded-md"><CardContent className="p-5 text-center"><Activity className="w-8 h-8 text-green-600 mx-auto mb-2" /><p className="text-3xl font-bold text-green-600">{stats.active_now}</p><p className="text-xs text-slate-500">Active Now</p></CardContent></Card>
        <Card className="rounded-md"><CardContent className="p-5 text-center"><Clock className="w-8 h-8 text-[#2E6CC4] mx-auto mb-2" /><p className="text-3xl font-bold">{stats.today_logs}</p><p className="text-xs text-slate-500">Activities Today</p></CardContent></Card>
        <Card className="rounded-md"><CardContent className="p-5 text-center"><FileText className="w-8 h-8 text-purple-600 mx-auto mb-2" /><p className="text-3xl font-bold">{stats.total_files}</p><p className="text-xs text-slate-500">Total Files</p></CardContent></Card>
        <Card className="rounded-md"><CardContent className="p-5 text-center"><Share2 className="w-8 h-8 text-amber-600 mx-auto mb-2" /><p className="text-3xl font-bold">{stats.total_shared}</p><p className="text-xs text-slate-500">Shared Items</p></CardContent></Card>
      </div>
      <Card className="rounded-md"><CardHeader><CardTitle className="text-sm">Most Active Staff Today</CardTitle></CardHeader>
        <CardContent>
          {stats.top_active?.length > 0 ? (
            <div className="space-y-2">{stats.top_active.map((s, i) => (
              <div key={i} className="flex items-center justify-between py-2 border-b border-slate-50 last:border-0">
                <div className="flex items-center gap-3"><div className="w-8 h-8 rounded-md bg-[#2E6CC4] flex items-center justify-center text-white text-xs font-bold">{s.name?.charAt(0)}</div><span className="text-sm font-medium">{s.name}</span></div>
                <Badge className="bg-green-100 text-green-700">{s.count} activities</Badge>
              </div>
            ))}</div>
          ) : <p className="text-sm text-slate-400 text-center py-4">No activity yet today</p>}
        </CardContent>
      </Card>
    </div>
  );
}


function LiveActivityView() {
  const [logs, setLogs] = useState([]);
  const [filter, setFilter] = useState('');
  const load = () => api.get('/working-paper/activity/all', { params: { limit: 50 } }).then(r => setLogs(r.data)).catch(() => {});
  useEffect(() => { load(); const t = setInterval(load, 15000); return () => clearInterval(t); }, []);

  const actionColors = {
    create_lesson: 'bg-blue-100 text-blue-700', enter_scores: 'bg-green-100 text-green-700',
    record_attendance: 'bg-purple-100 text-purple-700', create_assignment: 'bg-amber-100 text-amber-700',
    upload_file: 'bg-indigo-100 text-indigo-700', manual_log: 'bg-slate-100 text-slate-700',
  };

  const filtered = filter ? logs.filter(l => l.user_name?.toLowerCase().includes(filter.toLowerCase()) || l.description?.toLowerCase().includes(filter.toLowerCase())) : logs;

  return (
    <div className="space-y-4">
      <div className="flex items-center gap-3">
        <div className="relative flex-1"><Search className="w-4 h-4 absolute left-3 top-2.5 text-slate-400" /><Input placeholder="Filter by name or activity..." value={filter} onChange={e => setFilter(e.target.value)} className="pl-9 rounded-md" /></div>
        <Badge className="bg-green-100 text-green-700 animate-pulse">Live</Badge>
      </div>
      <div className="space-y-2">
        {filtered.map(l => (
          <div key={l.log_id} className="flex items-start gap-3 bg-white rounded-md border p-3">
            <div className="w-8 h-8 rounded-md bg-[#2E6CC4] flex items-center justify-center text-white text-xs font-bold flex-shrink-0">{l.user_name?.charAt(0)}</div>
            <div className="flex-1 min-w-0">
              <div className="flex items-center gap-2">
                <span className="text-sm font-semibold text-[#1B2A4A]">{l.user_name}</span>
                <Badge className={actionColors[l.action] || 'bg-slate-100 text-slate-600'} >{l.action?.replace(/_/g, ' ')}</Badge>
                {l.shared && <Eye className="w-3 h-3 text-green-600" />}
              </div>
              <p className="text-xs text-slate-500 mt-0.5">{l.description}</p>
              <p className="text-[10px] text-slate-400 mt-0.5">{new Date(l.created_at).toLocaleString()}</p>
            </div>
          </div>
        ))}
        {filtered.length === 0 && <p className="text-sm text-slate-400 text-center py-8">No activity recorded yet</p>}
      </div>
    </div>
  );
}


function StaffPapersView() {
  const [staff, setStaff] = useState([]);
  const [selected, setSelected] = useState(null);
  const [paperData, setPaperData] = useState(null);
  const [search, setSearch] = useState('');

  useEffect(() => { api.get('/admin/staff').then(r => setStaff(r.data.filter(s => s.role !== 'Student' && s.role !== 'Parent'))).catch(() => {}); }, []);

  const openPaper = async (s) => {
    setSelected(s);
    try { const r = await api.get(`/working-paper/staff/${s.user_id}`); setPaperData(r.data); } catch { toast.error('Failed to load'); }
  };

  if (selected && paperData) {
    return (
      <div className="space-y-4">
        <Button variant="ghost" size="sm" onClick={() => { setSelected(null); setPaperData(null); }}><ArrowLeft className="w-4 h-4 mr-1" /> Back to Staff</Button>
        <div className="bg-white rounded-md border p-4 flex items-center gap-4">
          <div className="w-12 h-12 rounded-md bg-[#2E6CC4] flex items-center justify-center text-white text-lg font-bold">{selected.name?.charAt(0)}</div>
          <div><h2 className="text-lg font-bold text-[#1B2A4A]">{selected.name}</h2><p className="text-xs text-slate-500">{selected.role} | {selected.department || 'No department'}</p></div>
        </div>

        <div className="grid md:grid-cols-3 gap-3">
          <Card className="rounded-md"><CardContent className="p-4 text-center"><p className="text-2xl font-bold">{paperData.logs.length}</p><p className="text-xs text-slate-500">Activities</p></CardContent></Card>
          <Card className="rounded-md"><CardContent className="p-4 text-center"><p className="text-2xl font-bold">{paperData.files.length}</p><p className="text-xs text-slate-500">Files</p></CardContent></Card>
          <Card className="rounded-md"><CardContent className="p-4 text-center"><p className="text-2xl font-bold">{paperData.logs.filter(l => l.shared).length}</p><p className="text-xs text-slate-500">Shared</p></CardContent></Card>
        </div>

        <Card className="rounded-md"><CardHeader><CardTitle className="text-sm">Activity Timeline</CardTitle></CardHeader>
          <CardContent><div className="space-y-2 max-h-[400px] overflow-y-auto">
            {paperData.logs.map(l => (
              <div key={l.log_id} className="flex items-start gap-2 py-2 border-b border-slate-50 last:border-0">
                <div className={`w-2 h-2 rounded-full mt-1.5 flex-shrink-0 ${l.shared ? 'bg-green-500' : 'bg-slate-300'}`} />
                <div>
                  <p className="text-xs text-[#1B2A4A]"><span className="font-semibold">{l.action?.replace(/_/g, ' ')}</span> — {l.description}</p>
                  <p className="text-[10px] text-slate-400">{new Date(l.created_at).toLocaleString()}{l.shared && ' | Shared'}</p>
                </div>
              </div>
            ))}
            {paperData.logs.length === 0 && <p className="text-xs text-slate-400 text-center py-4">No activity</p>}
          </div></CardContent>
        </Card>

        {paperData.files.length > 0 && (
          <Card className="rounded-md"><CardHeader><CardTitle className="text-sm">Files ({paperData.files.length})</CardTitle></CardHeader>
            <CardContent><div className="space-y-1">
              {paperData.files.map(f => (
                <div key={f.wp_file_id} className="flex items-center justify-between bg-slate-50 rounded p-2">
                  <div className="flex items-center gap-2"><FileText className="w-4 h-4 text-slate-400" /><div><p className="text-xs font-medium">{f.title}</p><p className="text-[10px] text-slate-400">{new Date(f.created_at).toLocaleDateString()}</p></div></div>
                  {f.shared && <Badge className="bg-green-100 text-green-700 text-[9px]">Shared</Badge>}
                </div>
              ))}
            </div></CardContent>
          </Card>
        )}
      </div>
    );
  }

  const filteredStaff = staff.filter(s => s.name?.toLowerCase().includes(search.toLowerCase()));

  return (
    <div className="space-y-4">
      <div className="relative"><Search className="w-4 h-4 absolute left-3 top-2.5 text-slate-400" /><Input placeholder="Search staff..." value={search} onChange={e => setSearch(e.target.value)} className="pl-9 rounded-md" /></div>
      <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
        {filteredStaff.map(s => (
          <Card key={s.user_id} className="rounded-md card-hover cursor-pointer" onClick={() => openPaper(s)}>
            <CardContent className="p-4 flex items-center gap-3">
              <div className="w-10 h-10 rounded-md bg-[#2E6CC4] flex items-center justify-center text-white font-bold">{s.name?.charAt(0)}</div>
              <div className="flex-1"><p className="text-sm font-semibold text-[#1B2A4A]">{s.name}</p><p className="text-[10px] text-slate-400">{s.role} | {s.department}</p></div>
              <Eye className="w-4 h-4 text-slate-400" />
            </CardContent>
          </Card>
        ))}
      </div>
    </div>
  );
}


function MyPaperView({ user }) {
  const [logs, setLogs] = useState([]);
  const [folders, setFolders] = useState([]);
  const [files, setFiles] = useState([]);
  const [subTab, setSubTab] = useState('activity');
  const [logText, setLogText] = useState('');
  const [folderDialog, setFolderDialog] = useState(false);
  const [folderForm, setFolderForm] = useState({ name: '', level: 'subject' });
  const [fileDialog, setFileDialog] = useState(false);
  const [fileForm, setFileForm] = useState({ title: '', description: '', folder_id: '', shared: false });
  const [uploading, setUploading] = useState(false);
  const [uploadedFileId, setUploadedFileId] = useState('');
  const fileRef = React.useRef(null);

  const load = () => {
    api.get('/working-paper/activity').then(r => setLogs(r.data)).catch(() => {});
    api.get('/working-paper/folders').then(r => setFolders(r.data)).catch(() => {});
    api.get('/working-paper/files').then(r => setFiles(r.data)).catch(() => {});
  };
  useEffect(() => { load(); }, []);

  const addLog = async () => {
    if (!logText.trim()) return;
    try { await api.post('/working-paper/logs', { description: logText, shared: false }); setLogText(''); load(); successToast('Log added'); } catch { toast.error('Failed'); }
  };

  const toggleShare = async (logId) => {
    try { await api.put(`/working-paper/logs/${logId}/share`); load(); } catch {}
  };

  const createFolder = async (e) => {
    e.preventDefault();
    try { await api.post('/working-paper/folders', folderForm); setFolderDialog(false); setFolderForm({ name: '', level: 'subject' }); load(); successToast('Folder created'); } catch { toast.error('Failed'); }
  };

  const handleFileUpload = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setUploading(true);
    try {
      const fd = new FormData(); fd.append('file', file);
      const res = await api.post('/files/upload', fd, { headers: { 'Content-Type': 'multipart/form-data' } });
      setUploadedFileId(res.data.file_id);
      setFileForm(prev => ({ ...prev, title: prev.title || file.name }));
      successToast('File uploaded');
    } catch { toast.error('Upload failed'); }
    setUploading(false);
    e.target.value = '';
  };

  const saveFile = async (e) => {
    e.preventDefault();
    if (!uploadedFileId) { toast.error('Upload a file first'); return; }
    try { await api.post('/working-paper/files', { ...fileForm, file_id: uploadedFileId }); setFileDialog(false); setFileForm({ title: '', description: '', folder_id: '', shared: false }); setUploadedFileId(''); load(); successToast('File added'); } catch { toast.error('Failed'); }
  };

  const deleteFile = async (id) => {
    try { await api.delete(`/working-paper/files/${id}`); load(); } catch {}
  };

  return (
    <div className="space-y-4">
      <Tabs value={subTab} onValueChange={setSubTab}>
        <TabsList className="bg-white border"><TabsTrigger value="activity" className="text-xs">Activity Log</TabsTrigger><TabsTrigger value="files" className="text-xs">Files & Folders</TabsTrigger></TabsList>

        <TabsContent value="activity" className="mt-3 space-y-4">
          <div className="flex gap-2">
            <Input placeholder="What are you working on?" value={logText} onChange={e => setLogText(e.target.value)} className="flex-1" onKeyDown={e => e.key === 'Enter' && addLog()} />
            <Button className="rounded-md bg-[#2E6CC4]" onClick={addLog}><Plus className="w-4 h-4 mr-1" /> Log</Button>
          </div>
          <div className="space-y-2">
            {logs.map(l => (
              <div key={l.log_id} className="flex items-start gap-3 bg-white rounded-md border p-3">
                <div className={`w-2 h-2 rounded-full mt-1.5 flex-shrink-0 ${l.shared ? 'bg-green-500' : 'bg-slate-300'}`} />
                <div className="flex-1">
                  <div className="flex items-center gap-2">
                    <Badge className={l.action === 'manual_log' ? 'bg-slate-100 text-slate-600' : 'bg-blue-100 text-blue-700'} >{l.action?.replace(/_/g, ' ')}</Badge>
                    {l.shared ? <Badge className="bg-green-100 text-green-700 text-[9px]"><Eye className="w-2.5 h-2.5 mr-0.5" />Shared</Badge> : <Badge className="bg-slate-100 text-slate-500 text-[9px]"><EyeOff className="w-2.5 h-2.5 mr-0.5" />Private</Badge>}
                  </div>
                  <p className="text-sm text-[#1B2A4A] mt-1">{l.description}</p>
                  <p className="text-[10px] text-slate-400 mt-0.5">{new Date(l.created_at).toLocaleString()}</p>
                </div>
                <Button variant="ghost" size="sm" className="h-7 text-[10px]" onClick={() => toggleShare(l.log_id)}>{l.shared ? 'Unshare' : 'Share'}</Button>
              </div>
            ))}
            {logs.length === 0 && <p className="text-sm text-slate-400 text-center py-8">No activity yet. Start logging your work above.</p>}
          </div>
        </TabsContent>

        <TabsContent value="files" className="mt-3 space-y-4">
          <div className="flex gap-2">
            <Button variant="outline" className="rounded-md" onClick={() => setFolderDialog(true)}><FolderOpen className="w-4 h-4 mr-1" /> New Folder</Button>
            <Button className="rounded-md bg-[#2E6CC4]" onClick={() => setFileDialog(true)}><Upload className="w-4 h-4 mr-1" /> Upload File</Button>
          </div>

          {folders.length > 0 && (
            <div className="space-y-2">
              <h3 className="text-xs font-semibold text-slate-500 uppercase">Folders</h3>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-2">
                {folders.map(f => (
                  <div key={f.folder_id} className="flex items-center gap-2 bg-white rounded-md border p-3 cursor-pointer hover:border-[#2E6CC4]">
                    <FolderOpen className="w-5 h-5 text-amber-500" />
                    <div><p className="text-xs font-semibold">{f.name}</p><p className="text-[10px] text-slate-400">{f.level}</p></div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div className="space-y-2">
            <h3 className="text-xs font-semibold text-slate-500 uppercase">Files ({files.length})</h3>
            {files.map(f => (
              <div key={f.wp_file_id} className="flex items-center justify-between bg-white rounded-md border p-3">
                <div className="flex items-center gap-3">
                  <FileText className="w-5 h-5 text-[#2E6CC4]" />
                  <div><p className="text-sm font-medium">{f.title}</p>{f.description && <p className="text-[10px] text-slate-400">{f.description}</p>}<p className="text-[10px] text-slate-400">{new Date(f.created_at).toLocaleDateString()}</p></div>
                </div>
                <div className="flex items-center gap-2">
                  {f.shared ? <Badge className="bg-green-100 text-green-700 text-[9px]">Shared</Badge> : <Badge className="bg-slate-100 text-slate-500 text-[9px]">Private</Badge>}
                  <Button variant="ghost" size="sm" className="h-7 text-red-500" onClick={() => deleteFile(f.wp_file_id)}><Trash2 className="w-3 h-3" /></Button>
                </div>
              </div>
            ))}
            {files.length === 0 && <p className="text-sm text-slate-400 text-center py-6">No files uploaded yet</p>}
          </div>
        </TabsContent>
      </Tabs>

      {/* Folder Dialog */}
      <Dialog open={folderDialog} onOpenChange={setFolderDialog}>
        <DialogContent><DialogHeader><DialogTitle>Create Folder</DialogTitle></DialogHeader>
          <form onSubmit={createFolder} className="space-y-3">
            <Input placeholder="Folder name (e.g. Mathematics, Year 7)" value={folderForm.name} onChange={e => setFolderForm({...folderForm, name: e.target.value})} required />
            <Select value={folderForm.level} onValueChange={v => setFolderForm({...folderForm, level: v})}><SelectTrigger><SelectValue /></SelectTrigger><SelectContent><SelectItem value="subject">Subject</SelectItem><SelectItem value="class">Class / Year Group</SelectItem><SelectItem value="workspace">Workspace</SelectItem></SelectContent></Select>
            <Button type="submit" className="w-full rounded-md bg-[#2E6CC4]">Create</Button>
          </form>
        </DialogContent>
      </Dialog>

      {/* File Upload Dialog */}
      <Dialog open={fileDialog} onOpenChange={setFileDialog}>
        <DialogContent><DialogHeader><DialogTitle>Upload File</DialogTitle></DialogHeader>
          <form onSubmit={saveFile} className="space-y-3">
            <Input placeholder="File title" value={fileForm.title} onChange={e => setFileForm({...fileForm, title: e.target.value})} required />
            <Textarea placeholder="Description (optional)" value={fileForm.description} onChange={e => setFileForm({...fileForm, description: e.target.value})} rows={2} />
            {folders.length > 0 && (
              <Select value={fileForm.folder_id} onValueChange={v => setFileForm({...fileForm, folder_id: v})}><SelectTrigger><SelectValue placeholder="Select folder (optional)" /></SelectTrigger><SelectContent>{folders.map(f => <SelectItem key={f.folder_id} value={f.folder_id}>{f.name}</SelectItem>)}</SelectContent></Select>
            )}
            <input ref={fileRef} type="file" className="hidden" onChange={handleFileUpload} accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.jpg,.png,.txt,.csv" />
            <Button type="button" variant="outline" className="w-full rounded-md border-dashed border-2" onClick={() => fileRef.current?.click()} disabled={uploading}>
              <Upload className="w-4 h-4 mr-2" /> {uploading ? 'Uploading...' : uploadedFileId ? 'File uploaded' : 'Choose file'}
            </Button>
            <label className="flex items-center gap-2 text-xs cursor-pointer"><input type="checkbox" checked={fileForm.shared} onChange={e => setFileForm({...fileForm, shared: e.target.checked})} className="rounded" /> Share to Working Paper (visible to management)</label>
            <Button type="submit" className="w-full rounded-md bg-[#2E6CC4]">Save</Button>
          </form>
        </DialogContent>
      </Dialog>
    </div>
  );
}
