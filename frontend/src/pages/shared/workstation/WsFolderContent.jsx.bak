import React from 'react';
import api from '../../../lib/api';
import { Card, CardContent } from '../../../components/ui/card';
import { Button } from '../../../components/ui/button';
import { Badge } from '../../../components/ui/badge';
import { FolderOpen, ArrowLeft, Trash2, Lock, Archive } from 'lucide-react';
import { STATUS_COLORS, CLASS_CONFIG, getFileConfig } from './wsConstants';

export function FolderGridItem({ folder, onClick }) {
  const c = CLASS_CONFIG[folder.classification] || CLASS_CONFIG.public;
  const CIcon = c.icon;
  return (
    <div className="flex items-center gap-2.5 p-3 bg-white rounded-md border cursor-pointer hover:border-[#2E6CC4]/40 hover:shadow-sm transition-all" onClick={onClick} data-testid={`folder-${folder.folder_id}`}>
      <FolderOpen className="w-5 h-5 text-amber-500 shrink-0" />
      <p className="text-xs font-semibold truncate flex-1">{folder.name}</p>
      <CIcon className={`w-3 h-3 ${c.color} opacity-60`} />
    </div>
  );
}

export function FolderListItem({ folder, onClick }) {
  const c = CLASS_CONFIG[folder.classification] || CLASS_CONFIG.public;
  return (
    <div className="flex items-center gap-3 py-2 px-3 rounded-md cursor-pointer hover:bg-slate-50" onClick={onClick}>
      <FolderOpen className="w-4 h-4 text-amber-500" />
      <span className="text-sm font-medium flex-1">{folder.name}</span>
      <Badge variant="secondary" className="text-[9px]">{c.label}</Badge>
    </div>
  );
}

export function DocGridItem({ doc, onClick }) {
  const fc = getFileConfig(doc.file_type);
  const FI = fc.icon;
  return (
    <div className="p-3 bg-white rounded-md border cursor-pointer hover:border-[#2E6CC4]/40 hover:shadow-sm transition-all" onClick={onClick} data-testid={`doc-${doc.document_id}`}>
      <div className="flex items-center gap-2 mb-2">
        <div className={`w-8 h-8 ${fc.bg} rounded flex items-center justify-center`}><FI className={`w-4 h-4 ${fc.color}`} /></div>
        <Badge className={`text-[8px] ml-auto ${STATUS_COLORS[doc.status]}`}>{doc.status}</Badge>
      </div>
      <p className="text-xs font-semibold text-[#1B2A4A] truncate">{doc.title}</p>
      <p className="text-[10px] text-slate-400 mt-0.5">v{doc.version} | {doc.author_name}</p>
      {doc.locked && <Lock className="w-3 h-3 text-red-400 mt-1" />}
    </div>
  );
}

export function DocListItem({ doc, onClick }) {
  const fc = getFileConfig(doc.file_type);
  const FI = fc.icon;
  return (
    <div className="flex items-center gap-3 py-2 px-3 rounded-md cursor-pointer hover:bg-slate-50" onClick={onClick}>
      <FI className={`w-4 h-4 ${fc.color}`} />
      <span className="text-sm font-medium flex-1 truncate">{doc.title}</span>
      <span className="text-[10px] text-slate-400">{(doc.file_type || '').toUpperCase()}</span>
      <Badge className={`text-[9px] ${STATUS_COLORS[doc.status]}`}>{doc.status}</Badge>
    </div>
  );
}

export function FolderContent({ folder, viewMode, openFolder, goBack, isAdmin, archiveFolder, deleteFolder, setSelectedDoc, user }) {
  const cls = CLASS_CONFIG[folder.classification] || CLASS_CONFIG.public;
  const CI = cls.icon;
  const openDoc = async (docId) => { try { const r = await api.get(`/wp/documents/${docId}`); setSelectedDoc(r.data); } catch {} };
  const hasSub = folder.subfolders && folder.subfolders.length > 0;
  const hasDocs = folder.documents && folder.documents.length > 0;
  const hasEntries = folder.entries && folder.entries.length > 0;
  const isEmpty = !hasSub && !hasDocs && !hasEntries;

  return (
    <div className="space-y-4 animate-fade-in">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-3">
          <Button variant="ghost" size="sm" onClick={goBack} className="h-7"><ArrowLeft className="w-4 h-4" /></Button>
          <div>
            <div className="flex items-center gap-2">
              <h2 className="text-lg font-bold text-[#1B2A4A]">{folder.name}</h2>
              <Badge className={`text-[9px] ${cls.bg} border`}><CI className={`w-2.5 h-2.5 mr-0.5 ${cls.color}`} />{cls.label}</Badge>
            </div>
            {folder.description && <p className="text-[11px] text-slate-500 mt-0.5">{folder.description}</p>}
          </div>
        </div>
        {(isAdmin || folder.owner_id === (user && user.user_id)) && (
          <div className="flex gap-1">
            <Button size="sm" variant="ghost" className="h-7 text-xs text-amber-600" onClick={() => archiveFolder(folder.folder_id)}><Archive className="w-3 h-3 mr-1" /> Archive</Button>
            <Button size="sm" variant="ghost" className="h-7 text-xs text-red-500" onClick={() => deleteFolder(folder.folder_id)}><Trash2 className="w-3 h-3" /></Button>
          </div>
        )}
      </div>
      {hasSub && <FolderSubsection items={folder.subfolders} viewMode={viewMode} openFolder={openFolder} />}
      {hasDocs && <DocSubsection items={folder.documents} viewMode={viewMode} openDoc={openDoc} />}
      {hasEntries && <EntrySubsection items={folder.entries} />}
      {isEmpty && <EmptyFolder />}
    </div>
  );
}

function FolderSubsection({ items, viewMode, openFolder }) {
  return (
    <div className="space-y-2">
      <h3 className="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Folders ({items.length})</h3>
      {viewMode === 'grid'
        ? <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">{items.map(f => <FolderGridItem key={f.folder_id} folder={f} onClick={() => openFolder(f.folder_id)} />)}</div>
        : <div className="space-y-0.5">{items.map(f => <FolderListItem key={f.folder_id} folder={f} onClick={() => openFolder(f.folder_id)} />)}</div>
      }
    </div>
  );
}

function DocSubsection({ items, viewMode, openDoc }) {
  return (
    <div className="space-y-2">
      <h3 className="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Documents ({items.length})</h3>
      {viewMode === 'grid'
        ? <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">{items.map(d => <DocGridItem key={d.document_id} doc={d} onClick={() => openDoc(d.document_id)} />)}</div>
        : <div className="space-y-0.5">{items.map(d => <DocListItem key={d.document_id} doc={d} onClick={() => openDoc(d.document_id)} />)}</div>
      }
    </div>
  );
}

function EntrySubsection({ items }) {
  return (
    <div className="space-y-2">
      <h3 className="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Entries ({items.length})</h3>
      <div className="space-y-1">{items.map(e => (
        <div key={e.entry_id} className="p-3 bg-slate-50 rounded-md border border-slate-100">
          <div className="flex items-center justify-between mb-1">
            <div className="flex items-center gap-2"><Badge variant="secondary" className="text-[9px]">{e.entry_type}</Badge><h4 className="text-xs font-semibold">{e.title}</h4></div>
            <span className="text-[10px] text-slate-400">{e.author_name}</span>
          </div>
          <p className="text-[11px] text-slate-600 line-clamp-2">{e.content}</p>
        </div>
      ))}</div>
    </div>
  );
}

function EmptyFolder() {
  return (
    <div className="flex flex-col items-center justify-center py-16 text-slate-400">
      <FolderOpen className="w-12 h-12 mb-3 text-slate-300" />
      <p className="text-sm font-medium mb-1">This folder is empty</p>
      <p className="text-xs">Upload documents or create subfolders</p>
    </div>
  );
}

export function RootFolders({ folders, viewMode, openFolder, isAdmin, seedDefaults }) {
  if (folders.length === 0) return <EmptyFolder />;
  if (viewMode === 'grid') {
    return (
      <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 animate-fade-in">
        {folders.map(f => {
          const cls = CLASS_CONFIG[f.classification] || CLASS_CONFIG.public;
          const CI = cls.icon;
          return (
            <Card key={f.folder_id} className="rounded-lg cursor-pointer hover:border-[#2E6CC4]/40 hover:shadow-sm transition-all" onClick={() => openFolder(f.folder_id)} data-testid={`root-folder-${f.folder_id}`}>
              <CardContent className="p-3.5">
                <div className="flex items-start justify-between mb-2"><FolderOpen className="w-7 h-7 text-amber-500" /><CI className={`w-3.5 h-3.5 ${cls.color}`} /></div>
                <h3 className="text-xs font-semibold text-[#1B2A4A] mb-0.5 truncate">{f.name}</h3>
                <p className="text-[10px] text-slate-400">{f.department || 'General'}</p>
              </CardContent>
            </Card>
          );
        })}
      </div>
    );
  }
  return (
    <div className="space-y-0.5 animate-fade-in">
      {folders.map(f => <FolderListItem key={f.folder_id} folder={f} onClick={() => openFolder(f.folder_id)} />)}
    </div>
  );
}
