import React from 'react';
import api from '../../../lib/api';
import { Card, CardContent, CardHeader, CardTitle } from '../../../components/ui/card';
import { Button } from '../../../components/ui/button';
import { Badge } from '../../../components/ui/badge';
import { FolderOpen, FileText, Clock, Archive, Users, History } from 'lucide-react';
import { STATUS_COLORS, CLASS_CONFIG, getFileConfig } from './wsConstants';

export function DashboardView({ stats, tree, openFolder, setActiveTab, seedDefaults, isAdmin, setSelectedDoc }) {
  if (!stats) return <div className="flex justify-center py-16"><div className="w-8 h-8 border-4 border-[#2E6CC4] border-t-transparent rounded-full animate-spin" /></div>;

  const statCards = [
    { label: 'Folders', value: stats.total_folders, icon: FolderOpen, color: 'text-amber-500', bg: 'bg-amber-50' },
    { label: 'Documents', value: stats.total_documents, icon: FileText, color: 'text-[#2E6CC4]', bg: 'bg-blue-50' },
    { label: 'Pending Approval', value: stats.pending_approvals, icon: Clock, color: 'text-amber-600', bg: 'bg-amber-50' },
    { label: 'Archived', value: (stats.archived_folders || 0) + (stats.archived_documents || 0), icon: Archive, color: 'text-slate-500', bg: 'bg-slate-100' },
    { label: 'Activity', value: stats.recent_activity?.length || 0, icon: Users, color: 'text-emerald-600', bg: 'bg-emerald-50' },
  ];

  return (
    <div className="space-y-5 animate-fade-in">
      <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
        {statCards.map((s, i) => {
          const Icon = s.icon;
          return (
            <Card key={i} className="rounded-lg">
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className={`w-10 h-10 ${s.bg} rounded-lg flex items-center justify-center`}><Icon className={`w-5 h-5 ${s.color}`} /></div>
                  <div><p className="text-xl font-bold text-[#1B2A4A]">{s.value}</p><p className="text-[10px] text-slate-500">{s.label}</p></div>
                </div>
              </CardContent>
            </Card>
          );
        })}
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        <Card className="rounded-lg">
          <CardHeader className="pb-2"><CardTitle className="text-sm flex items-center gap-2"><FileText className="w-4 h-4 text-[#2E6CC4]" /> Recent Documents</CardTitle></CardHeader>
          <CardContent>
            <div className="space-y-1 max-h-[250px] overflow-y-auto">
              {stats.recent_documents?.length > 0 ? stats.recent_documents.map(d => {
                const fc = getFileConfig(d.file_type);
                const FIcon = fc.icon;
                return (
                  <div key={d.document_id} className="flex items-center gap-2.5 py-2 border-b border-slate-50 last:border-0 cursor-pointer hover:bg-slate-50 rounded px-2"
                    onClick={async () => { try { const r = await api.get(`/wp/documents/${d.document_id}`); setSelectedDoc(r.data); } catch {} }}>
                    <div className={`w-8 h-8 ${fc.bg} rounded flex items-center justify-center`}><FIcon className={`w-4 h-4 ${fc.color}`} /></div>
                    <div className="flex-1 min-w-0"><p className="text-xs font-medium truncate">{d.title}</p><p className="text-[10px] text-slate-400">{d.author_name} | {new Date(d.updated_at).toLocaleDateString()}</p></div>
                    <Badge className={`text-[9px] ${STATUS_COLORS[d.status]}`}>{d.status}</Badge>
                  </div>
                );
              }) : <p className="text-xs text-slate-400 text-center py-4">No documents yet</p>}
            </div>
          </CardContent>
        </Card>

        <Card className="rounded-lg">
          <CardHeader className="pb-2"><CardTitle className="text-sm flex items-center gap-2"><History className="w-4 h-4 text-emerald-600" /> Recent Activity</CardTitle></CardHeader>
          <CardContent>
            <div className="space-y-1 max-h-[250px] overflow-y-auto">
              {stats.recent_activity?.length > 0 ? stats.recent_activity.map((a, i) => (
                <div key={i} className="flex items-center gap-2 py-1.5 border-b border-slate-50 last:border-0 text-xs px-1">
                  <div className="w-1.5 h-1.5 rounded-full bg-[#2E6CC4] shrink-0" />
                  <span className="font-semibold text-[#1B2A4A]">{a.user_name}</span>
                  <span className="text-slate-500">{a.action?.replace(/_/g, ' ')}</span>
                  <span className="text-slate-400 ml-auto text-[10px] shrink-0">{new Date(a.timestamp).toLocaleString()}</span>
                </div>
              )) : <p className="text-xs text-slate-400 text-center py-4">No activity yet</p>}
            </div>
          </CardContent>
        </Card>
      </div>

      {tree.length > 0 && (
        <div className="space-y-2">
          <h3 className="text-sm font-semibold text-[#1B2A4A]">Institutional Folders</h3>
          <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-2">
            {tree.slice(0, 10).map(f => {
              const cls = CLASS_CONFIG[f.classification] || CLASS_CONFIG.public;
              const CI = cls.icon;
              return (
                <div key={f.folder_id} className="flex items-center gap-2.5 p-3 bg-white rounded-lg border cursor-pointer hover:border-[#2E6CC4]/40 hover:shadow-sm transition-all" onClick={() => openFolder(f.folder_id)}>
                  <FolderOpen className="w-5 h-5 text-amber-500 shrink-0" />
                  <p className="text-xs font-medium truncate text-[#1B2A4A] flex-1">{f.name}</p>
                  <CI className={`w-3 h-3 shrink-0 ${cls.color}`} />
                </div>
              );
            })}
          </div>
          {tree.length > 10 && <button className="text-xs text-[#2E6CC4] hover:underline" onClick={() => setActiveTab('browse')}>View all {tree.length} folders</button>}
        </div>
      )}

      {tree.length === 0 && isAdmin && (
        <div className="flex flex-col items-center py-12 text-slate-400">
          <FolderOpen className="w-12 h-12 mb-3 text-slate-300" />
          <p className="text-sm mb-3">No institutional folders set up yet</p>
          <Button size="sm" className="rounded-md bg-[#2E6CC4]" onClick={seedDefaults} data-testid="dashboard-seed-btn">Seed Institutional Folders</Button>
        </div>
      )}
    </div>
  );
}
