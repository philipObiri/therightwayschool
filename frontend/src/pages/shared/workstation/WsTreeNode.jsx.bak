import React, { useState } from 'react';
import { FolderOpen, ChevronRight } from 'lucide-react';

function SingleNode({ folder, depth, activeId, onSelect, renderChildren }) {
  const [expanded, setExpanded] = useState(depth === 0);
  const hasKids = folder.children && folder.children.length > 0;
  const isActive = activeId === folder.folder_id;
  const pl = depth * 14 + 8;
  const cls = isActive ? 'bg-[#2E6CC4]/10 text-[#2E6CC4] font-semibold' : 'text-slate-600 hover:bg-slate-50';
  const iconCls = isActive ? 'text-[#2E6CC4]' : 'text-amber-500';

  return (
    <div data-ve-dynamic="true">
      <div className={`flex items-center gap-1.5 py-1.5 px-2 cursor-pointer rounded-md text-xs transition-all ${cls}`} style={{ paddingLeft: pl }} onClick={() => onSelect(folder.folder_id)}>
        {hasKids
          ? <button onClick={e => { e.stopPropagation(); setExpanded(!expanded); }} className="w-4 h-4 flex items-center justify-center shrink-0"><ChevronRight className={`w-3 h-3 transition-transform ${expanded ? 'rotate-90' : ''}`} /></button>
          : <span className="w-4 shrink-0" />
        }
        <FolderOpen className={`w-3.5 h-3.5 shrink-0 ${iconCls}`} />
        <span className="truncate">{folder.name}</span>
      </div>
      {expanded && hasKids && renderChildren(folder.children, depth + 1)}
    </div>
  );
}

export function FolderTree({ tree, activeId, onSelect }) {
  const renderLevel = (items, depth) => {
    if (depth > 10 || !items) return null;
    return items.map(f => (
      <SingleNode key={f.folder_id} folder={f} depth={depth} activeId={activeId} onSelect={onSelect} renderChildren={renderLevel} />
    ));
  };
  return <div data-testid="folder-tree">{renderLevel(tree, 0)}</div>;
}
