import React, { useEffect, useState, useCallback, useRef } from 'react';
import api from '../../lib/api';
import { useAuth } from '../../contexts/AuthContext';
import { Button } from '../../components/ui/button';
import { Input } from '../../components/ui/input';
import { Label } from '../../components/ui/label';
import { Textarea } from '../../components/ui/textarea';
import { Badge } from '../../components/ui/badge';
import { Card, CardContent, CardHeader, CardTitle } from '../../components/ui/card';
import { Dialog, DialogContent, DialogHeader, DialogTitle } from '../../components/ui/dialog';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '../../components/ui/select';
import {
  FolderOpen, FileText, Upload, Search, ArrowLeft, X, Send, Check, Lock, Unlock,
  BarChart3, Clock, Archive, FolderPlus, Download, RefreshCw, History
} from 'lucide-react';
import { toast } from 'sonner';
import { successToast } from '../../lib/successToast';
import { STATUS_COLORS, getFileConfig } from './workstation/wsConstants';
import { DashboardView } from './workstation/WsDashboard';
import { BrowseView } from './workstation/WsBrowse';
import { DocListView } from './workstation/WsDocList';
import { CommentsSection } from './workstation/WsComments';

const BACKEND = import.meta.env.VITE_API_URL;

export default function DocumentWorkstation() {
  const { user } = useAuth();
  const isAdmin = ['SuperAdmin', 'Admin', 'CEO', 'Principal', 'HeadTeacher'].includes(user?.role);

  const [activeTab, setActiveTab] = useState('dashboard');
  const [currentFolder, setCurrentFolder] = useState(null);
  const [folders, setFolders] = useState([]);
  const [tree, setTree] = useState([]);
  const [stats, setStats] = useState(null);
  const [selectedDoc, setSelectedDoc] = useState(null);
  const [viewMode, setViewMode] = useState('grid');
  const [showTree, setShowTree] = useState(true);
  const [loading, setLoading] = useState(false);
  const [search, setSearch] = useState('');
  const [searchResults, setSearchResults] = useState(null);
  const [docList, setDocList] = useState([]);
  const [folderDialog, setFolderDialog] = useState(false);
  const [docDialog, setDocDialog] = useState(false);
  const [entryDialog, setEntryDialog] = useState(false);
  const [permDialog, setPermDialog] = useState(false);
  const [folderForm, setFolderForm] = useState({ name: '', description: '', classification: 'public', department: '', allowed_users: [] });
  const [docForm, setDocForm] = useState({ title: '', description: '', file_id: '', file_type: '', tags: '' });
  const [entryForm, setEntryForm] = useState({ title: '', content: '', entry_type: 'note' });
  const [permForm, setPermForm] = useState({ user_id: '', role: '', permissions: [] });
  const [uploading, setUploading] = useState(false);
  const [staff, setStaff] = useState([]);
  const fileRef = useRef(null);
  const previewRef = useRef(null);
  const [previewUrl, setPreviewUrl] = useState(null);

  const activeParentId = currentFolder?.folder_id || '';

  const loadStats = useCallback(() => api.get('/wp/stats').then(r => setStats(r.data)).catch(() => {}), []);
  const loadTree = useCallback(() => api.get('/wp/folder-tree').then(r => setTree(r.data)).catch(() => {}), []);
  const loadFolders = useCallback((parentId = '') => api.get('/wp/folders', { params: { parent_id: parentId } }).then(r => setFolders(r.data)).catch(() => {}), []);

  useEffect(() => { loadStats(); loadTree(); loadFolders(); if (isAdmin) api.get('/admin/staff').then(r => setStaff(r.data)).catch(() => {}); }, []);

  const openFolder = async (folderId) => {
    setLoading(true); setSelectedDoc(null);
    try { const r = await api.get(`/wp/folders/${folderId}`); setCurrentFolder(r.data); setActiveTab('browse'); } catch (err) { toast.error(err.response?.data?.detail || 'Cannot open folder'); }
    setLoading(false);
  };
  const goBack = () => { if (currentFolder?.parent_id) openFolder(currentFolder.parent_id); else { setCurrentFolder(null); loadFolders(); } };
  const goHome = () => { setCurrentFolder(null); setSelectedDoc(null); loadFolders(); };

  const createFolder = async (e) => {
    e.preventDefault();
    try { await api.post('/wp/folders', { ...folderForm, parent_id: activeParentId }); successToast('Folder created'); setFolderDialog(false); setFolderForm({ name: '', description: '', classification: 'public', department: '', allowed_users: [] }); if (activeParentId) openFolder(activeParentId); else loadFolders(); loadTree(); } catch (err) { toast.error(err.response?.data?.detail || 'Failed'); }
  };
  const handleFileUpload = async (e) => {
    const file = e.target.files?.[0]; if (!file) return; setUploading(true);
    try { const fd = new FormData(); fd.append('file', file); const res = await api.post('/files/upload', fd, { headers: { 'Content-Type': 'multipart/form-data' } }); setDocForm(prev => ({ ...prev, file_id: res.data.file_id, file_type: file.name.split('.').pop(), title: prev.title || file.name })); successToast('File uploaded'); } catch { toast.error('Upload failed'); }
    setUploading(false); e.target.value = '';
  };
  const uploadDocument = async (e) => {
    e.preventDefault(); if (!docForm.file_id) { toast.error('Upload a file first'); return; }
    try { await api.post('/wp/documents', { ...docForm, folder_id: activeParentId, tags: docForm.tags.split(',').map(t => t.trim()).filter(Boolean) }); successToast('Document uploaded'); setDocDialog(false); setDocForm({ title: '', description: '', file_id: '', file_type: '', tags: '' }); if (activeParentId) openFolder(activeParentId); loadStats(); } catch (err) { toast.error(err.response?.data?.detail || 'Failed'); }
  };
  const createEntry = async (e) => {
    e.preventDefault();
    try { await api.post('/wp/entries', { ...entryForm, folder_id: activeParentId }); successToast('Entry created'); setEntryDialog(false); setEntryForm({ title: '', content: '', entry_type: 'note' }); if (activeParentId) openFolder(activeParentId); } catch (err) { toast.error(err.response?.data?.detail || 'Failed'); }
  };
  const doSearch = async () => { if (!search.trim()) { setSearchResults(null); return; } try { const r = await api.get('/wp/search', { params: { q: search } }); setSearchResults(r.data); } catch {} };
  const changeStatus = async (docId, status) => {
    try { await api.put(`/wp/documents/${docId}/status`, { status }); successToast(`Status: ${status}`); if (selectedDoc) { const r = await api.get(`/wp/documents/${docId}`); setSelectedDoc(r.data); } if (currentFolder) openFolder(currentFolder.folder_id); loadStats(); } catch (err) { toast.error(err.response?.data?.detail || 'Failed'); }
  };
  const deleteFolder = async (folderId) => { if (!window.confirm('Delete this folder?')) return; try { await api.delete(`/wp/folders/${folderId}`); successToast('Deleted'); goBack(); loadTree(); loadStats(); } catch { toast.error('Failed'); } };
  const archiveFolder = async (folderId) => { try { await api.put(`/wp/folders/${folderId}/archive`); successToast('Archived'); goBack(); loadTree(); loadStats(); } catch (err) { toast.error(err.response?.data?.detail || 'Failed'); } };
  const seedDefaults = async () => { try { const r = await api.post('/wp/seed-defaults'); successToast(r.data.message); loadTree(); loadFolders(); loadStats(); } catch { toast.error('Failed'); } };
  const addPermission = async () => { try { await api.post(`/wp/folders/${currentFolder.folder_id}/permissions`, permForm); successToast('Permission set'); setPermDialog(false); setPermForm({ user_id: '', role: '', permissions: [] }); openFolder(currentFolder.folder_id); } catch (err) { toast.error(err.response?.data?.detail || 'Failed'); } };
  const loadTabData = (tab) => {
    setActiveTab(tab); setSelectedDoc(null);
    if (tab === 'my-files') api.get('/wp/my-documents').then(r => setDocList(r.data)).catch(() => {});
    if (tab === 'pending') api.get('/wp/pending-approvals').then(r => setDocList(r.data)).catch(() => {});
    if (tab === 'archive') api.get('/wp/archived').then(r => setDocList(r.data)).catch(() => {});
    if (tab === 'dashboard') loadStats();
  };

  useEffect(() => {
    if (!selectedDoc?.file_id) return;
    setPreviewUrl(null);
    const token = localStorage.getItem('rw_token');
    fetch(`${BACKEND}/api/files/${selectedDoc.file_id}/preview`, { headers: { Authorization: `Bearer ${token}` } })
      .then(r => { if (!r.ok) throw new Error(); return r.blob(); })
      .then(blob => { const url = URL.createObjectURL(blob); previewRef.current = url; setPreviewUrl(url); })
      .catch(() => setPreviewUrl('error'));
    return () => { if (previewRef.current) { URL.revokeObjectURL(previewRef.current); previewRef.current = null; } };
  }, [selectedDoc?.file_id]);

  const tabs = [
    { id: 'dashboard', label: 'Dashboard', icon: BarChart3 },
    { id: 'browse', label: 'Browse', icon: FolderOpen },
    { id: 'my-files', label: 'My Files', icon: FileText },
    { id: 'pending', label: 'Pending', icon: Clock },
    { id: 'archive', label: 'Archive', icon: Archive },
  ];

  if (selectedDoc) {
    return <DocDetailView doc={selectedDoc} previewUrl={previewUrl} isAdmin={isAdmin} onBack={() => setSelectedDoc(null)} onStatusChange={changeStatus} setSelectedDoc={setSelectedDoc} />;
  }

  return (
    <div className="space-y-4" data-testid="document-workstation">
      <div className="flex items-center justify-between">
        <div><h1 className="text-2xl font-bold font-[Manrope] text-[#1B2A4A]" data-testid="ws-title">Document Workstation</h1><p className="text-sm text-slate-500 mt-0.5">Institutional records, governance & collaboration</p></div>
        <div className="flex items-center gap-2">
          {isAdmin && tree.length === 0 && <Button variant="outline" size="sm" className="rounded-md text-xs" onClick={seedDefaults} data-testid="seed-folders-btn"><RefreshCw className="w-3.5 h-3.5 mr-1.5" /> Seed Folders</Button>}
          <Button size="sm" className="rounded-md bg-[#2E6CC4] text-xs" onClick={() => setFolderDialog(true)} data-testid="new-folder-btn"><FolderPlus className="w-3.5 h-3.5 mr-1.5" /> New Folder</Button>
          <Button size="sm" className="rounded-md bg-[#1B2A4A] text-xs" onClick={() => setDocDialog(true)} data-testid="upload-btn"><Upload className="w-3.5 h-3.5 mr-1.5" /> Upload</Button>
        </div>
      </div>

      <div className="flex items-center gap-0.5 border-b border-slate-200" data-testid="ws-tabs">
        {tabs.map(tab => { const Icon = tab.icon; return (
          <button key={tab.id} data-testid={`tab-${tab.id}`} onClick={() => loadTabData(tab.id)} className={`flex items-center gap-1.5 px-4 py-2.5 text-xs font-medium border-b-2 transition-all ${activeTab === tab.id ? 'border-[#2E6CC4] text-[#2E6CC4]' : 'border-transparent text-slate-500 hover:text-slate-700'}`}>
            <Icon className="w-3.5 h-3.5" />{tab.label}
            {tab.id === 'pending' && stats?.pending_approvals > 0 && <span className="ml-1 px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded-full text-[10px] font-bold">{stats.pending_approvals}</span>}
          </button>
        ); })}
      </div>

      <div className="flex gap-2">
        <div className="relative flex-1"><Search className="w-4 h-4 absolute left-3 top-2.5 text-slate-400" /><Input placeholder="Search documents, folders, tags..." value={search} onChange={e => setSearch(e.target.value)} onKeyDown={e => e.key === 'Enter' && doSearch()} className="pl-9 rounded-md h-9 text-sm" data-testid="ws-search-input" /></div>
        <Button size="sm" onClick={doSearch} className="rounded-md bg-[#2E6CC4]" data-testid="ws-search-btn"><Search className="w-3.5 h-3.5" /></Button>
      </div>

      {searchResults && <SearchResultsPanel results={searchResults} onClose={() => setSearchResults(null)} openFolder={openFolder} setSelectedDoc={setSelectedDoc} />}

      {activeTab === 'dashboard' && <DashboardView stats={stats} tree={tree} openFolder={openFolder} setActiveTab={setActiveTab} seedDefaults={seedDefaults} isAdmin={isAdmin} setSelectedDoc={setSelectedDoc} />}
      {activeTab === 'browse' && <BrowseView showTree={showTree} setShowTree={setShowTree} tree={tree} currentFolder={currentFolder} openFolder={openFolder} goHome={goHome} goBack={goBack} viewMode={viewMode} setViewMode={setViewMode} setFolderDialog={setFolderDialog} setDocDialog={setDocDialog} setEntryDialog={setEntryDialog} setPermDialog={setPermDialog} isAdmin={isAdmin} loading={loading} archiveFolder={archiveFolder} deleteFolder={deleteFolder} folders={folders} seedDefaults={seedDefaults} setSelectedDoc={setSelectedDoc} user={user} />}
      {(activeTab === 'my-files' || activeTab === 'pending' || activeTab === 'archive') && <DocListView activeTab={activeTab} docList={docList} isAdmin={isAdmin} setSelectedDoc={setSelectedDoc} loadTabData={loadTabData} loadTree={loadTree} />}

      <Dialog open={folderDialog} onOpenChange={setFolderDialog}><DialogContent className="sm:max-w-lg max-h-[90vh] overflow-y-auto"><DialogHeader><DialogTitle>{currentFolder ? `New Subfolder in "${currentFolder.name}"` : 'Create Folder'}</DialogTitle></DialogHeader>
        <form onSubmit={createFolder} className="space-y-3">
          <div className="space-y-1"><Label className="text-xs">Folder Name</Label><Input value={folderForm.name} onChange={e => setFolderForm({...folderForm, name: e.target.value})} required data-testid="folder-name-input" /></div>
          <div className="space-y-1"><Label className="text-xs">Description</Label><Textarea value={folderForm.description} onChange={e => setFolderForm({...folderForm, description: e.target.value})} rows={2} /></div>
          <div className="grid grid-cols-2 gap-3">
            <div className="space-y-1"><Label className="text-xs">Classification</Label><Select value={folderForm.classification} onValueChange={v => setFolderForm({...folderForm, classification: v})}><SelectTrigger><SelectValue /></SelectTrigger><SelectContent><SelectItem value="public">Public</SelectItem><SelectItem value="restricted">Restricted</SelectItem><SelectItem value="confidential">Confidential</SelectItem><SelectItem value="approval_controlled">Approval Controlled</SelectItem></SelectContent></Select></div>
            <div className="space-y-1"><Label className="text-xs">Department</Label><Input value={folderForm.department} onChange={e => setFolderForm({...folderForm, department: e.target.value})} /></div>
          </div>
          {folderForm.classification !== 'public' && staff.length > 0 && <div className="space-y-2 bg-slate-50 rounded-md p-3 border"><Label className="text-xs font-semibold">Authorized Access</Label>
            <div className="max-h-[150px] overflow-y-auto space-y-1">{staff.map(s => { const chk = folderForm.allowed_users.includes(s.user_id); return <label key={s.user_id} className={`flex items-center gap-2 p-1.5 rounded border text-xs cursor-pointer ${chk ? 'border-[#2E6CC4] bg-blue-50' : 'border-slate-200'}`}><input type="checkbox" checked={chk} onChange={e => { const u = e.target.checked ? [...folderForm.allowed_users, s.user_id] : folderForm.allowed_users.filter(id => id !== s.user_id); setFolderForm({...folderForm, allowed_users: u}); }} /><span className="font-medium">{s.name}</span><span className="text-slate-400">{s.role}</span></label>; })}</div>
          </div>}
          <Button type="submit" className="w-full rounded-md bg-[#2E6CC4]" data-testid="create-folder-submit">Create Folder</Button>
        </form>
      </DialogContent></Dialog>

      <Dialog open={docDialog} onOpenChange={setDocDialog}><DialogContent><DialogHeader><DialogTitle>Upload Document {currentFolder ? `to "${currentFolder.name}"` : ''}</DialogTitle></DialogHeader>
        <form onSubmit={uploadDocument} className="space-y-3">
          <div className="space-y-1"><Label className="text-xs">Title</Label><Input value={docForm.title} onChange={e => setDocForm({...docForm, title: e.target.value})} required data-testid="doc-title-input" /></div>
          <div className="space-y-1"><Label className="text-xs">Description</Label><Textarea value={docForm.description} onChange={e => setDocForm({...docForm, description: e.target.value})} rows={2} /></div>
          <div className="space-y-1"><Label className="text-xs">Tags (comma separated)</Label><Input value={docForm.tags} onChange={e => setDocForm({...docForm, tags: e.target.value})} /></div>
          <input ref={fileRef} type="file" className="hidden" onChange={handleFileUpload} accept=".pdf,.docx,.xlsx,.pptx,.jpg,.jpeg,.png,.txt,.csv,.doc,.xls,.ppt,.svg,.zip" />
          <Button type="button" variant="outline" className="w-full rounded-md border-dashed border-2 h-20" onClick={() => fileRef.current?.click()} disabled={uploading} data-testid="file-upload-area">
            <div className="flex flex-col items-center gap-1"><Upload className="w-5 h-5 text-slate-400" /><span className="text-xs text-slate-500">{uploading ? 'Uploading...' : docForm.file_id ? `Ready (${docForm.file_type?.toUpperCase()})` : 'Click to select file'}</span></div>
          </Button>
          <Button type="submit" className="w-full rounded-md bg-[#2E6CC4]" data-testid="upload-doc-submit">Save Document</Button>
        </form>
      </DialogContent></Dialog>

      <Dialog open={entryDialog} onOpenChange={setEntryDialog}><DialogContent><DialogHeader><DialogTitle>Create Entry</DialogTitle></DialogHeader>
        <form onSubmit={createEntry} className="space-y-3">
          <div className="space-y-1"><Label className="text-xs">Type</Label><Select value={entryForm.entry_type} onValueChange={v => setEntryForm({...entryForm, entry_type: v})}><SelectTrigger><SelectValue /></SelectTrigger><SelectContent><SelectItem value="note">Note</SelectItem><SelectItem value="meeting_minutes">Meeting Minutes</SelectItem><SelectItem value="report">Report</SelectItem><SelectItem value="log">Log</SelectItem></SelectContent></Select></div>
          <div className="space-y-1"><Label className="text-xs">Title</Label><Input value={entryForm.title} onChange={e => setEntryForm({...entryForm, title: e.target.value})} required /></div>
          <div className="space-y-1"><Label className="text-xs">Content</Label><Textarea value={entryForm.content} onChange={e => setEntryForm({...entryForm, content: e.target.value})} rows={6} /></div>
          <Button type="submit" className="w-full rounded-md bg-[#2E6CC4]">Create Entry</Button>
        </form>
      </DialogContent></Dialog>

      <Dialog open={permDialog} onOpenChange={setPermDialog}><DialogContent><DialogHeader><DialogTitle>Manage Access</DialogTitle></DialogHeader>
        <div className="space-y-3">
          <div className="space-y-1"><Label className="text-xs">User</Label><Select value={permForm.user_id} onValueChange={v => setPermForm({...permForm, user_id: v, role: ''})}><SelectTrigger><SelectValue placeholder="Select user" /></SelectTrigger><SelectContent>{staff.map(s => <SelectItem key={s.user_id} value={s.user_id}>{s.name} ({s.role})</SelectItem>)}</SelectContent></Select></div>
          <p className="text-[10px] text-slate-400 text-center">- or by role -</p>
          <div className="space-y-1"><Label className="text-xs">Role</Label><Select value={permForm.role} onValueChange={v => setPermForm({...permForm, role: v, user_id: ''})}><SelectTrigger><SelectValue placeholder="Select role" /></SelectTrigger><SelectContent>{['Teacher','Admin','HeadTeacher','Principal','FinanceOfficer','HR_Officer','CEO','SuperAdmin'].map(r => <SelectItem key={r} value={r}>{r}</SelectItem>)}</SelectContent></Select></div>
          <div className="space-y-1"><Label className="text-xs">Permissions</Label>
            <div className="grid grid-cols-3 gap-1">{['view','access','upload','edit','comment','approve','download','delete','create_subfolder','manage_permissions'].map(p => (
              <label key={p} className={`flex items-center gap-1 p-1.5 rounded border text-[10px] cursor-pointer ${permForm.permissions.includes(p) ? 'border-[#2E6CC4] bg-blue-50' : 'border-slate-200'}`}><input type="checkbox" checked={permForm.permissions.includes(p)} onChange={e => { const ps = e.target.checked ? [...permForm.permissions, p] : permForm.permissions.filter(x => x !== p); setPermForm({...permForm, permissions: ps}); }} />{p}</label>
            ))}</div>
          </div>
          <Button className="w-full rounded-md bg-[#2E6CC4]" onClick={addPermission} data-testid="set-permission-btn">Set Permission</Button>
        </div>
      </DialogContent></Dialog>
    </div>
  );
}

function SearchResultsPanel({ results, onClose, openFolder, setSelectedDoc }) {
  return (
    <Card className="rounded-lg border-[#2E6CC4]/20"><CardContent className="p-4 space-y-2">
      <div className="flex items-center justify-between"><h3 className="text-sm font-semibold text-[#1B2A4A]">Search Results</h3><Button variant="ghost" size="sm" onClick={onClose}><X className="w-3.5 h-3.5" /></Button></div>
      {results.folders?.map(f => <div key={f.folder_id} className="flex items-center gap-2 p-2.5 bg-slate-50 rounded-md cursor-pointer hover:bg-slate-100" onClick={() => { openFolder(f.folder_id); onClose(); }}><FolderOpen className="w-4 h-4 text-amber-500" /><span className="text-sm font-medium">{f.name}</span><Badge variant="secondary" className="text-[9px] ml-auto">{f.department}</Badge></div>)}
      {results.documents?.map(d => { const fc = getFileConfig(d.file_type); const FI = fc.icon; return <div key={d.document_id} className="flex items-center gap-2 p-2.5 bg-slate-50 rounded-md cursor-pointer hover:bg-slate-100" onClick={async () => { try { const r = await api.get(`/wp/documents/${d.document_id}`); setSelectedDoc(r.data); onClose(); } catch {} }}><FI className={`w-4 h-4 ${fc.color}`} /><span className="text-sm">{d.title}</span><Badge className={`ml-auto text-[9px] ${STATUS_COLORS[d.status]}`}>{d.status}</Badge></div>; })}
      {!results.folders?.length && !results.documents?.length && <p className="text-xs text-slate-400 text-center py-3">No results</p>}
    </CardContent></Card>
  );
}

function DocDetailView({ doc, previewUrl, isAdmin, onBack, onStatusChange, setSelectedDoc }) {
  const fc = getFileConfig(doc.file_type);
  const FIcon = fc.icon;
  const versionFileRef = React.useRef(null);
  const [versionUploading, setVersionUploading] = React.useState(false);
  const [changeSummary, setChangeSummary] = React.useState('');
  const [showVersionUpload, setShowVersionUpload] = React.useState(false);

  const uploadNewVersion = async (e) => {
    const file = e.target.files?.[0]; if (!file) return;
    setVersionUploading(true);
    try {
      const fd = new FormData(); fd.append('file', file);
      const res = await api.post('/files/upload', fd, { headers: { 'Content-Type': 'multipart/form-data' } });
      await api.put(`/wp/documents/${doc.document_id}`, {
        file_id: res.data.file_id,
        file_type: file.name.split('.').pop(),
        change_summary: changeSummary || `Updated to ${file.name}`
      });
      successToast('New version uploaded');
      setShowVersionUpload(false);
      setChangeSummary('');
      const r = await api.get(`/wp/documents/${doc.document_id}`);
      setSelectedDoc(r.data);
    } catch { toast.error('Upload failed'); }
    setVersionUploading(false);
    e.target.value = '';
  };

  return (
    <div className="space-y-4 animate-fade-in" data-testid="document-detail-view">
      <Button variant="ghost" size="sm" onClick={onBack} data-testid="doc-back-btn"><ArrowLeft className="w-4 h-4 mr-1" /> Back</Button>
      <div className="bg-white rounded-lg border p-5">
        <div className="flex items-start justify-between gap-4">
          <div className="flex items-start gap-3 min-w-0">
            <div className={`w-12 h-12 ${fc.bg} rounded-lg flex items-center justify-center shrink-0`}><FIcon className={`w-6 h-6 ${fc.color}`} /></div>
            <div className="min-w-0"><h2 className="text-lg font-bold text-[#1B2A4A]">{doc.title}</h2>
              <div className="flex items-center gap-2 mt-1 flex-wrap">
                <Badge className={`text-[10px] ${STATUS_COLORS[doc.status]}`}>{doc.status}</Badge>
                {doc.locked && <Badge className="text-[10px] bg-purple-50 text-purple-700"><Lock className="w-2.5 h-2.5 mr-0.5" />Locked</Badge>}
                <span className="text-[10px] text-slate-400">v{doc.version} | {doc.author_name} | {doc.file_type?.toUpperCase()} | {new Date(doc.created_at).toLocaleDateString()}</span>
              </div>
            </div>
          </div>
          <div className="flex gap-1.5 shrink-0 flex-wrap justify-end">
            {doc.file_id && <Button variant="outline" size="sm" className="rounded-md text-xs" data-testid="download-btn" onClick={() => { const t = localStorage.getItem('rw_token'); window.open(`${BACKEND}/api/files/${doc.file_id}/download?token=${t}`, '_blank'); }}><Download className="w-3 h-3 mr-1" /> Download</Button>}
            {!doc.locked && <Button variant="outline" size="sm" className="rounded-md text-xs" data-testid="upload-version-btn" onClick={() => setShowVersionUpload(!showVersionUpload)}><Upload className="w-3 h-3 mr-1" /> New Version</Button>}
            {isAdmin && doc.status === 'under_review' && <>
              <Button size="sm" className="rounded-md bg-emerald-600 text-xs" data-testid="approve-btn" onClick={() => onStatusChange(doc.document_id, 'approved')}><Check className="w-3 h-3 mr-1" /> Approve</Button>
              <Button size="sm" className="rounded-md bg-red-600 text-xs" data-testid="reject-btn" onClick={() => onStatusChange(doc.document_id, 'rejected')}><X className="w-3 h-3 mr-1" /> Reject</Button>
            </>}
            {doc.status === 'draft' && <Button size="sm" className="rounded-md bg-amber-600 text-xs" data-testid="submit-review-btn" onClick={() => onStatusChange(doc.document_id, 'under_review')}><Send className="w-3 h-3 mr-1" /> Submit for Review</Button>}
            {isAdmin && <Button size="sm" variant="ghost" className="text-xs" onClick={async () => { try { await api.put(`/wp/documents/${doc.document_id}/lock`, { locked: !doc.locked }); successToast(doc.locked ? 'Unlocked' : 'Locked'); const r = await api.get(`/wp/documents/${doc.document_id}`); setSelectedDoc(r.data); } catch { toast.error('Failed'); } }}>{doc.locked ? <Unlock className="w-3.5 h-3.5" /> : <Lock className="w-3.5 h-3.5" />}</Button>}
          </div>
        </div>
        {doc.description && <p className="text-sm text-slate-600 mt-3">{doc.description}</p>}
        {doc.tags?.length > 0 && <div className="flex gap-1 mt-2">{doc.tags.map(t => <Badge key={t} variant="secondary" className="text-[9px]">{t}</Badge>)}</div>}
        {showVersionUpload && (
          <div className="mt-3 p-3 bg-blue-50 rounded-lg border border-blue-200 space-y-2">
            <p className="text-xs font-semibold text-[#1B2A4A]">Upload New Version (Current: v{doc.version})</p>
            <Input placeholder="Change summary (optional)" value={changeSummary} onChange={e => setChangeSummary(e.target.value)} className="text-xs h-8" />
            <input ref={versionFileRef} type="file" className="hidden" onChange={uploadNewVersion} />
            <Button size="sm" className="rounded-md bg-[#2E6CC4] text-xs" onClick={() => versionFileRef.current?.click()} disabled={versionUploading}>
              <Upload className="w-3 h-3 mr-1" /> {versionUploading ? 'Uploading...' : 'Select File'}
            </Button>
          </div>
        )}
      </div>

      {doc.file_id && <FilePreview doc={doc} previewUrl={previewUrl} fc={fc} />}

      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {doc.versions?.length > 0 && <Card className="rounded-lg"><CardHeader className="pb-2"><CardTitle className="text-sm flex items-center gap-2"><History className="w-4 h-4" /> Version History</CardTitle></CardHeader><CardContent><div className="space-y-1">{doc.versions.map(v => <div key={v.version_id} className="flex items-center justify-between py-2 border-b border-slate-50 last:border-0 text-xs"><div><Badge variant={v.version === doc.version ? 'default' : 'secondary'} className="text-[9px] mr-2">v{v.version}</Badge>{v.change_summary} <span className="text-slate-400">by {v.edited_by_name}</span></div><span className="text-slate-400 text-[10px]">{new Date(v.created_at).toLocaleString()}</span></div>)}</div></CardContent></Card>}
        {doc.status_history?.length > 0 && <Card className="rounded-lg"><CardHeader className="pb-2"><CardTitle className="text-sm">Workflow History</CardTitle></CardHeader><CardContent><div className="space-y-1.5">{doc.status_history.map((h, i) => <div key={i} className="flex items-center gap-2 text-xs"><Badge className={`text-[9px] ${STATUS_COLORS[h.status]}`}>{h.status}</Badge><span>by {h.by}</span>{h.feedback && <span className="text-slate-400 italic">- {h.feedback}</span>}<span className="text-slate-400 ml-auto text-[10px]">{new Date(h.at).toLocaleString()}</span></div>)}</div></CardContent></Card>}
      </div>
      <CommentsSection entityType="document" entityId={doc.document_id} />
    </div>
  );
}

function FilePreview({ doc, previewUrl, fc }) {
  const FIcon = fc.icon;
  const openDownload = () => { const t = localStorage.getItem('rw_token'); window.open(`${BACKEND}/api/files/${doc.file_id}/download?token=${t}`, '_blank'); };
  return (
    <div className="bg-white rounded-lg border overflow-hidden" style={{ height: '500px' }}>
      {previewUrl === 'error' ? (
        <div className="flex flex-col items-center justify-center h-full text-slate-400"><FIcon className={`w-16 h-16 mb-3 ${fc.color} opacity-30`} /><p className="text-sm mb-3">Preview not available</p><Button variant="outline" className="rounded-md" onClick={openDownload}><Download className="w-4 h-4 mr-2" /> Download</Button></div>
      ) : previewUrl ? (
        (doc.file_type || '').toLowerCase() === 'pdf' ? <embed src={previewUrl} type="application/pdf" className="w-full h-full" />
        : ['jpg','jpeg','png','svg','gif','webp'].includes((doc.file_type || '').toLowerCase()) ? <div className="w-full h-full flex items-center justify-center bg-slate-50 p-4"><img src={previewUrl} alt={doc.title} className="max-w-full max-h-full object-contain rounded" /></div>
        : <div className="flex flex-col items-center justify-center h-full text-slate-400"><FIcon className={`w-16 h-16 mb-3 ${fc.color} opacity-30`} /><p className="text-sm mb-3">.{doc.file_type?.toUpperCase()} file</p><Button variant="outline" className="rounded-md" onClick={openDownload}><Download className="w-4 h-4 mr-2" /> Download</Button></div>
      ) : <div className="flex items-center justify-center h-full"><div className="w-8 h-8 border-4 border-[#2E6CC4] border-t-transparent rounded-full animate-spin" /></div>}
    </div>
  );
}
